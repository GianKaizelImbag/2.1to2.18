public class desiderata { // Class declaration

    public static void main(String[] args) { // Main method

        System.out.println( // Output statement
            "Go placidly amid the noise and haste;"); // String literal

        System.out.println(
            "and remember what peace there may be in silence.");

        System.out.println(
            "As far as possible, without surrender,");

        System.out.println(
            "be on good terms with all persons. Speak your truth quietly and");

        System.out.println(
            "clearly; and listen to others, even to the dull and the ignorant;");

        System.out.println(
            "they too have their story.");

        System.out.println(
            "Avoid loud and aggressive persons.");

    } // End of main method

} // End of class
